{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:att:schema:execution:v2",
  "title": "ATT functional RUN definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionType",
    "packageId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-execution/v2"
    },
    "executionType": {
      "const": "run"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "environment": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "case",
                "template",
                "flow",
                "tool"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "definitionId",
            "selection"
          ],
          "properties": {
            "type": {
              "const": "nativeCase"
            },
            "definitionId": {
              "$ref": "#/definitions/nativeDefinitionId",
              "description": "Case-preserving package-scoped Definition ID resolved by the Server within the selected Package."
            },
            "selection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resolvedCaseIds"
              ],
              "properties": {
                "resolvedCaseIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/nativeCaseId"
                  },
                  "description": "Local Resolved Case IDs from the selected Definition, not qualified IDs or workbook/sidecar Case IDs."
                }
              }
            }
          }
        }
      ],
      "description": "Use type nativeCase with a Definition ID and local Resolved Case IDs for native execution; legacy target types retain their existing meanings."
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "excludeTags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "suiteDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "all": {
          "type": "boolean"
        },
        "rerunFailed": {
          "type": "boolean"
        }
      },
      "not": {
        "required": [
          "suites",
          "suiteDirectory"
        ]
      },
      "anyOf": [
        {
          "required": [
            "suites"
          ]
        },
        {
          "required": [
            "caseIds"
          ]
        },
        {
          "required": [
            "tags"
          ]
        },
        {
          "required": [
            "suiteDirectory"
          ]
        },
        {
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "const": true
            }
          }
        },
        {
          "required": [
            "rerunFailed"
          ],
          "properties": {
            "rerunFailed": {
              "const": true
            }
          }
        }
      ]
    },
    "input": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debug": {
          "type": "boolean"
        },
        "failFast": {
          "type": "boolean"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\.\\.?$)(?!.*\\.$)(?! )(?!.* $)(?![cC][oO][nN](?:\\.|$)|[pP][rR][nN](?:\\.|$)|[aA][uU][xX](?:\\.|$)|[nN][uU][lL](?:\\.|$)|[cC][oO][mM][1-9](?:\\.|$)|[lL][pP][tT][1-9](?:\\.|$))[^\\x00-\\x1f\\x7f-\\x9f\\\\/:*?\\\"<>|]+$"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "target"
      ],
      "not": {
        "required": [
          "selection"
        ]
      }
    },
    {
      "required": [
        "selection"
      ],
      "not": {
        "required": [
          "target"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "properties": {
              "type": {
                "enum": [
                  "template",
                  "flow",
                  "tool"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "input"
        ],
        "properties": {
          "options": {
            "not": {
              "required": [
                "failFast"
              ]
            }
          },
          "config": {
            "enum": [
              "config/config.yaml",
              null
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "input"
          ]
        }
      }
    }
  ],
  "description": "Version 2 adds an explicit package-scoped nativeCase target while preserving version 1 workbook/sidecar Case, resource, and batch selector semantics.",
  "definitions": {
    "nativeDefinitionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 126,
      "pattern": "^(?!.*(?:^|\\.)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|$))[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "nativeCaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])$)[A-Za-z0-9_-]+$",
      "description": "One path-safe local Case ID segment returned by the bounded native Definition resolver."
    }
  }
}
