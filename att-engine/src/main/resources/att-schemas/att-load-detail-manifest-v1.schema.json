{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:load-detail-manifest:v1",
  "type": "object",
  "required": ["schemaVersion", "complete", "aggregate", "workloads", "series", "detailFileCount", "detailBytes"],
  "properties": {
    "schemaVersion": { "const": "att-load-detail-manifest/v1" },
    "complete": { "const": true },
    "aggregate": { "type": "object", "required": ["series"], "properties": { "series": { "$ref": "#/$defs/seriesRecords" } }, "additionalProperties": false },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summaryPath", "series"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summaryPath": { "type": "string", "pattern": "^details/v1/workloads/workload-[0-9]{4}/summary\\.json$" },
          "series": { "$ref": "#/$defs/seriesRecords" }
        },
        "additionalProperties": false
      }
    },
    "series": { "$ref": "#/$defs/seriesRecords" },
    "detailFileCount": { "type": "integer", "minimum": 1, "maximum": 9000 },
    "detailBytes": { "type": "integer", "minimum": 2, "maximum": 104857600 }
  },
  "additionalProperties": false,
  "$defs": {
    "seriesRecords": { "type": "array", "items": { "$ref": "#/$defs/seriesRecord" } },
    "seriesRecord": {
      "type": "object",
      "required": ["scope", "target", "kind", "count", "inlinePreviewCount", "complete", "files"],
      "properties": {
        "scope": { "enum": ["aggregate", "workload"] },
        "workloadId": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "pattern": "^metrics(?:/|$)" },
        "kind": { "enum": ["map", "list"] },
        "count": { "type": "integer", "minimum": 1 },
        "inlinePreviewCount": { "type": "integer", "minimum": 0, "maximum": 32 },
        "complete": { "const": true },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^details/v1/[A-Za-z0-9._/-]+\\.json$" }
        }
      },
      "additionalProperties": false
    }
  }
}
