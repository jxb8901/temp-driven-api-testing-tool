{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:sut-metrics-manifest:v1",
  "title": "ATT companion SUT Metrics collection manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "state",
    "complete",
    "jobId",
    "files",
    "queries"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": "att-sut-metrics-manifest/v1"
    },
    "state": {
      "enum": [
        "DISABLED",
        "PENDING",
        "COLLECTING",
        "READY",
        "PARTIAL",
        "UNAVAILABLE",
        "FAILED"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "jobId": {
      "type": "string",
      "pattern": "^J[A-F0-9]{16}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "_integrity": {
      "$ref": "#/$defs/manifestIntegrity",
      "description": "Snapshot-anchored transition history stored in the same atomic publication as this manifest."
    },
    "windowStart": {
      "type": "string",
      "format": "date-time"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "queryId",
          "path",
          "lengthBytes",
          "sha256"
        ],
        "additionalProperties": true,
        "properties": {
          "queryId": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^series-[0-9]{4}\\.json$"
          },
          "lengthBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "manifestIntegrity": {
      "type": "object",
      "required": ["schemaVersion", "jobId", "snapshotId", "snapshotSha256", "entries"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "att-sut-metrics-manifest-integrity/v1" },
        "jobId": { "type": "string", "pattern": "^J[A-F0-9]{16}$" },
        "snapshotId": { "$ref": "#/$defs/digest" },
        "snapshotSha256": { "$ref": "#/$defs/digest" },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["sequence", "previousSha256", "manifestSha256", "state", "jobId", "snapshotId", "entrySha256"],
            "additionalProperties": false,
            "properties": {
              "sequence": { "type": "integer", "minimum": 1, "maximum": 16 },
              "previousSha256": { "$ref": "#/$defs/digest" },
              "manifestSha256": { "$ref": "#/$defs/digest" },
              "state": { "enum": ["PENDING", "COLLECTING", "READY", "PARTIAL", "UNAVAILABLE", "FAILED"] },
              "jobId": { "type": "string", "pattern": "^J[A-F0-9]{16}$" },
              "snapshotId": { "$ref": "#/$defs/digest" },
              "entrySha256": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
