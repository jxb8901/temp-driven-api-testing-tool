{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:load-detail-reference:v1",
  "type": "object",
  "required": ["schemaVersion", "complete", "series"],
  "properties": {
    "schemaVersion": { "const": "att-load-detail-reference/v1" },
    "complete": { "const": true },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "target", "kind", "count", "inlinePreviewCount", "complete", "files"],
        "properties": {
          "scope": { "enum": ["aggregate", "workload"] },
          "workloadId": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^metrics(?:/|$)" },
          "kind": { "enum": ["map", "list"] },
          "count": { "type": "integer", "minimum": 1 },
          "inlinePreviewCount": { "type": "integer", "minimum": 0, "maximum": 32 },
          "complete": { "const": true },
          "sharedContent": { "const": true },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^details/v1/[A-Za-z0-9._/-]+\\.json$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
