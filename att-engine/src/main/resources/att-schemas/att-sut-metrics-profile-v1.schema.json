{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:sut-metrics-profile:v1",
  "title": "ATT SUT Metrics Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "category"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "att-sut-metrics-profile/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "kind": {
      "enum": [
        "base",
        "derived",
        "composite"
      ]
    },
    "category": {
      "enum": [
        "os",
        "jvm",
        "app",
        "db",
        "mq",
        "custom"
      ]
    },
    "overridableParams": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      }
    },
    "allowTargetOverride": {
      "type": "boolean"
    },
    "allowSourceOverride": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "maxProperties": 40,
        "additionalProperties": {}
      }
    },
    "params": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "promLabelValue",
              "promLabelRegex",
              "text",
              "enum",
              "number",
              "duration"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": [
              "string",
              "number"
            ]
          },
          "allowedValues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "unit",
          "query"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unit": {
            "enum": [
              "percent",
              "bytes",
              "bytes_per_second",
              "seconds",
              "milliseconds",
              "count",
              "ratio",
              "cores",
              "custom"
            ]
          },
          "kind": {
            "enum": [
              "gauge",
              "rate",
              "counter",
              "histogram"
            ]
          },
          "category": {
            "enum": [
              "os",
              "jvm",
              "app",
              "db",
              "mq",
              "custom"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "not": {
              "pattern": ";"
            }
          }
        }
      }
    },
    "extends": {
      "type": "string"
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "profile"
        ],
        "additionalProperties": false,
        "properties": {
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "source": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "maxProperties": 40,
              "additionalProperties": {}
            }
          },
          "targetIds": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "base"
        }
      },
      "required": [
        "metrics"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "extends"
            ]
          },
          {
            "required": [
              "includes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "derived"
        }
      },
      "required": [
        "extends"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "metrics"
            ]
          },
          {
            "required": [
              "params"
            ]
          },
          {
            "required": [
              "includes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "composite"
        }
      },
      "required": [
        "includes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "extends"
            ]
          },
          {
            "required": [
              "metrics"
            ]
          },
          {
            "required": [
              "params"
            ]
          },
          {
            "required": [
              "parameters"
            ]
          }
        ]
      }
    }
  ]
}
