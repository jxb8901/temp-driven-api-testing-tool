{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:att:schema:execution:v1",
  "title": "ATT functional RUN definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionType",
    "packageId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-execution/v1"
    },
    "executionType": {
      "const": "run"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "environment": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "case",
            "template",
            "flow",
            "tool"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "excludeTags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "suiteDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "all": {
          "type": "boolean"
        },
        "rerunFailed": {
          "type": "boolean"
        }
      },
      "not": {
        "required": [
          "suites",
          "suiteDirectory"
        ]
      },
      "anyOf": [
        {
          "required": [
            "suites"
          ]
        },
        {
          "required": [
            "caseIds"
          ]
        },
        {
          "required": [
            "tags"
          ]
        },
        {
          "required": [
            "suiteDirectory"
          ]
        },
        {
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "const": true
            }
          }
        },
        {
          "required": [
            "rerunFailed"
          ],
          "properties": {
            "rerunFailed": {
              "const": true
            }
          }
        }
      ]
    },
    "input": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debug": {
          "type": "boolean"
        },
        "failFast": {
          "type": "boolean"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "target"
      ],
      "not": {
        "required": [
          "selection"
        ]
      }
    },
    {
      "required": [
        "selection"
      ],
      "not": {
        "required": [
          "target"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "properties": {
              "type": {
                "enum": [
                  "template",
                  "flow",
                  "tool"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "input"
        ],
        "properties": {
          "options": {
            "not": {
              "required": [
                "failFast"
              ]
            }
          },
          "config": {
            "enum": [
              "config/config.yaml",
              null
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "input"
          ]
        }
      }
    }
  ]
}
