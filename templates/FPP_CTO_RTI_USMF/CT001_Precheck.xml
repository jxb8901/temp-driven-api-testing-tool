<Txn>
    <TxHeader>
        <TxDate>#{sysdate("yyyyMMdd")}</TxDate>
        <TxTime>#{systimestamp("HHmmss")}</TxTime>
    </TxHeader>
    <TxBody>
        <TxCode>CT001</TxCode>
        <TxType>Precheck</TxType>
        <TxData>
            <PrecheckReq>
                <RequestId>${EXEC.VARS.TxnSeq}</RequestId>
                <CustomerId>${EXEC.INPUT.debitAccount}</CustomerId>
                <ProductId>${EXEC.INPUT.creditAccount}</ProductId>
                <OrderDetails>${EXEC.INPUT.amount}</OrderDetails>
            </PrecheckReq>
        </TxData>
    </TxBody>
</Txn>