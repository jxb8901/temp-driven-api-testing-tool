{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:flow:v3.6",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-flow/v3.6"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[^.]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "tool",
            "assert",
            "log",
            "assign",
            "flow"
          ]
        },
        "description": {
          "type": "string"
        },
        "onFailure": {
          "enum": [
            "stop",
            "continue"
          ]
        },
        "runWhen": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "call": {
          "type": "string"
        },
        "assert": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[^.]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/evidenceCollector"
          }
        },
        "use": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"
        },
        "value": {},
        "format": {
          "enum": [
            "text",
            "json",
            "yaml",
            "xml",
            "sqlplus"
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "flow"
              }
            }
          },
          "then": {
            "required": [
              "use"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "log"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "message"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "log"
              }
            },
            "required": [
              "type",
              "format"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "const": "log"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "format"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool"
              }
            }
          },
          "then": {
            "required": [
              "call"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assert"
              }
            }
          },
          "then": {
            "required": [
              "assert"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assign"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "expression"
            ]
          }
        }
      ]
    },
    "evidenceCollector": {
      "type": "object",
      "required": [
        "call"
      ],
      "properties": {
        "call": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "onFailure": {
          "enum": [
            "stop",
            "continue"
          ]
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": [
        "maxAttempts",
        "intervalMs",
        "retryOn"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "retryOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ASSERTION",
              "TIMEOUT"
            ]
          }
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "description": "Pure Boolean expression evaluated against the completed attempt only after retryOn matches."
        }
      },
      "additionalProperties": false
    }
  }
}
