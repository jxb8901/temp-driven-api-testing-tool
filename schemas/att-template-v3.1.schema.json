{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:template:v3.1",
  "type": "object",
  "required": ["schemaVersion", "description", "actions"],
  "properties": {
    "schemaVersion": {"const": "att-template/v3.1"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "actions": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[^.]+$"}, "additionalProperties": {"$ref": "#/$defs/action"}}
  },
  "patternProperties": {"^x-": {}},
  "additionalProperties": false,
  "$defs": {
    "result": {
      "type": "object",
      "properties": {"format": {"enum": ["raw", "text", "json", "yaml", "xml"]}, "path": {"type": "string", "minLength": 1}, "overwrite": {"type": "boolean", "default": false}},
      "additionalProperties": false
    },
    "sqlBlock": {
      "type": "object",
      "properties": {"sql": {"type": "string", "minLength": 1}, "sqlFile": {"type": "string", "minLength": 1}, "params": {"oneOf": [{"type": "array"}, {"type": "string", "minLength": 1}]}, "parameters": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}}, "additionalProperties": false,
      "oneOf": [{"required": ["sql"], "not": {"required": ["sqlFile"]}}, {"required": ["sqlFile"], "not": {"required": ["sql"]}}],
      "allOf": [{"not": {"required": ["params", "parameters"]}}]
    },
    "retry": {
      "type": "object", "required": ["maxAttempts", "intervalMs", "retryOn"],
      "properties": {"maxAttempts": {"type": "integer", "minimum": 2, "maximum": 10}, "intervalMs": {"type": "integer", "minimum": 0, "maximum": 3600000}, "retryOn": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ASSERTION", "TIMEOUT"]}}},
      "additionalProperties": false
    },
    "common": {
      "type": "object",
      "properties": {
        "type": {"enum": ["render", "tool", "db", "assert", "log", "assign", "flow"]}, "description": {"type": "string"}, "onFailure": {"enum": ["stop", "continue"]}, "runWhen": {"type": "string", "minLength": 1},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "expression": {"type": "string", "minLength": 1}, "payload": {"type": "string", "minLength": 1},
        "result": {"$ref": "#/$defs/result"}, "call": {"type": "string", "minLength": 1}, "db": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
        "query": {"$ref": "#/$defs/sqlBlock"}, "update": {"$ref": "#/$defs/sqlBlock"}, "assert": {"type": "string", "minLength": 1}, "expected": {"type": "string"}, "actual": {"type": "string"},
        "message": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "level": {"enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"]}, "fields": {"type": "object"},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 3600000}, "retry": {"$ref": "#/$defs/retry"},
        "evidence": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[^.]+$"}, "additionalProperties": {"type": "object"}}, "use": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"}
      },
      "patternProperties": {"^x-": {}}, "additionalProperties": false
    },
    "action": {
      "allOf": [{"$ref": "#/$defs/common"}, {"oneOf": [
        {"properties": {"type": {"const": "render"}, "result": {"type": "object", "required": ["format"], "properties": {"format": {"enum": ["raw", "text", "json", "yaml", "xml"]}, "path": {"type": "string", "minLength": 1}, "overwrite": {"type": "boolean"}}, "additionalProperties": false}}, "required": ["type", "payload", "result"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["expression"]}, {"required": ["call"]}, {"required": ["db"]}, {"required": ["query"]}, {"required": ["update"]}, {"required": ["message"]}, {"required": ["file"]}, {"required": ["level"]}, {"required": ["fields"]}, {"required": ["retry"]}, {"required": ["timeoutMs"]}, {"required": ["use"]}, {"required": ["evidence"]}]}},
        {"properties": {"type": {"const": "tool"}}, "required": ["type", "call"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["expression"]}, {"required": ["payload"]}, {"required": ["db"]}, {"required": ["query"]}, {"required": ["update"]}, {"required": ["message"]}, {"required": ["file"]}, {"required": ["level"]}, {"required": ["fields"]}, {"required": ["use"]}]}},
        {"properties": {"type": {"const": "db"}, "result": {"type": "object", "properties": {"format": {"enum": ["text", "json", "yaml", "xml"]}, "path": {"type": "string", "minLength": 1}, "overwrite": {"type": "boolean"}}, "additionalProperties": false}}, "required": ["type", "db"], "oneOf": [{"required": ["query"], "not": {"required": ["update"]}}, {"required": ["update"], "not": {"required": ["query"]}}], "not": {"anyOf": [{"required": ["name"]}, {"required": ["expression"]}, {"required": ["payload"]}, {"required": ["call"]}, {"required": ["expected"]}, {"required": ["actual"]}, {"required": ["message"]}, {"required": ["file"]}, {"required": ["level"]}, {"required": ["fields"]}, {"required": ["use"]}, {"required": ["evidence"]}]}},
        {"properties": {"type": {"const": "assert"}}, "required": ["type", "assert"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["expression"]}, {"required": ["payload"]}, {"required": ["result"]}, {"required": ["call"]}, {"required": ["db"]}, {"required": ["query"]}, {"required": ["update"]}, {"required": ["message"]}, {"required": ["file"]}, {"required": ["level"]}, {"required": ["fields"]}, {"required": ["retry"]}, {"required": ["timeoutMs"]}, {"required": ["use"]}, {"required": ["evidence"]}]}},
        {"properties": {"type": {"const": "log"}}, "required": ["type"], "anyOf": [{"required": ["message"]}, {"required": ["file"]}], "not": {"anyOf": [{"required": ["name"]}, {"required": ["expression"]}, {"required": ["payload"]}, {"required": ["result"]}, {"required": ["call"]}, {"required": ["db"]}, {"required": ["query"]}, {"required": ["update"]}, {"required": ["expected"]}, {"required": ["actual"]}, {"required": ["retry"]}, {"required": ["timeoutMs"]}, {"required": ["use"]}, {"required": ["evidence"]}]}},
        {"properties": {"type": {"const": "assign"}}, "required": ["type", "name", "expression"], "not": {"anyOf": [{"required": ["payload"]}, {"required": ["result"]}, {"required": ["call"]}, {"required": ["db"]}, {"required": ["query"]}, {"required": ["update"]}, {"required": ["expected"]}, {"required": ["actual"]}, {"required": ["message"]}, {"required": ["file"]}, {"required": ["level"]}, {"required": ["fields"]}, {"required": ["retry"]}, {"required": ["timeoutMs"]}, {"required": ["use"]}, {"required": ["evidence"]}]}},
        {"properties": {"type": {"const": "flow"}}, "required": ["type", "use"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["expression"]}, {"required": ["payload"]}, {"required": ["result"]}, {"required": ["call"]}, {"required": ["db"]}, {"required": ["query"]}, {"required": ["update"]}, {"required": ["assert"]}, {"required": ["expected"]}, {"required": ["actual"]}, {"required": ["message"]}, {"required": ["file"]}, {"required": ["level"]}, {"required": ["fields"]}, {"required": ["retry"]}, {"required": ["timeoutMs"]}, {"required": ["evidence"]}]}}
      ]}]
    }
  }
}
