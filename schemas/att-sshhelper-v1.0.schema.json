{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:sshhelper:v1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "instances"],
  "properties": {
    "schemaVersion": {"const": "att-sshhelper/v1.0"},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "defaults": {"type": "object", "properties": {"user": {"type": "string", "minLength": 1}, "port": {"$ref": "#/$defs/port"}, "identityFile": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "selection": {"type": "object", "required": ["strategy"], "properties": {"strategy": {"enum": ["random", "roundRobin", "all"]}}, "additionalProperties": false},
    "fanout": {"type": "object", "properties": {"maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 256}}, "additionalProperties": false},
    "instances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "host"], "properties": {"id": {"$ref": "#/$defs/id"}, "host": {"type": "string", "minLength": 1}, "user": {"type": "string", "minLength": 1}, "port": {"$ref": "#/$defs/port"}, "identityFile": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false,
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
}
