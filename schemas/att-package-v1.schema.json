{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:package:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "att-package/v1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "tags": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "uniqueItems": true
        }
      }
    },
    "defaultEnvironment": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templatesRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "testcaseRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "testdata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "descriptors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "environments": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "uniqueItems": true,
            "maxItems": 1000
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "default": {
                  "const": "timestamp"
                },
                "timestampFormat": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runIdFormat": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "debugIdFormat": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fileNamePattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "columns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "result": {
                  "type": "string",
                  "maxLength": 256
                },
                "durationMs": {
                  "type": "string",
                  "maxLength": 256
                },
                "expectedResult": {
                  "type": "string",
                  "maxLength": 256
                },
                "actualResult": {
                  "type": "string",
                  "maxLength": 256
                },
                "caseLog": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            "html": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "caseLogInlineLimitBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                }
              }
            },
            "junit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "caseLogEmbedThresholdBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                }
              }
            }
          }
        },
        "caseLog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yamlAnchors": {
              "type": "boolean"
            }
          }
        },
        "xml": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceMode": {
              "enum": [
                "ignore",
                "preserve"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion"
  ]
}
