{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:tool:v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-tool/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "call": {
      "type": "string",
      "minLength": 1,
      "pattern": "^#\\{[\\s\\S]*\\}$"
    },
    "cache": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "case",
            "db"
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "arguments": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^x-"
          },
          {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        ]
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "$ref": "#/$defs/argument"
      }
    },
    "stdoutFormat": {
      "enum": [
        "text",
        "json",
        "yaml",
        "xml"
      ]
    },
    "ssh": {
      "type": "object",
      "required": [
        "helper"
      ],
      "properties": {
        "helper": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object",
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "random",
                "roundRobin",
                "all"
              ]
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "required": [
        "command"
      ]
    },
    {
      "required": [
        "call"
      ]
    }
  ],
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "argName": {
          "type": "string",
          "pattern": "^\\S*$"
        },
        "argNameMode": {
          "enum": [
            "once",
            "repeat"
          ],
          "default": "once"
        },
        "delimit": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "any",
            "string",
            "integer",
            "long",
            "decimal",
            "boolean",
            "enum",
            "bytes",
            "map",
            "list"
          ]
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enumValues"
            ]
          }
        },
        {
          "if": {
            "required": [
              "enumValues"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  }
}
