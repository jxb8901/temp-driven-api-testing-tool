{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:load:v1.9",
  "title": "ATT load descriptor with engine-managed execution identities",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-load/v1.9"
    },
    "seed": {
      "type": "integer"
    },
    "testdata": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\.ya?ml$"
      }
    },
    "load": {
      "$ref": "#/$defs/loadOverride"
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workload"
      }
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "execution": {
      "$ref": "#/$defs/rootExecution"
    },
    "observability": {
      "$ref": "#/$defs/observability"
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "workloads"
          ]
        }
      },
      "then": {
        "required": [
          "load"
        ],
        "properties": {
          "load": {
            "$ref": "#/$defs/load"
          }
        }
      }
    }
  ],
  "$defs": {
    "workload": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": true
        },
        "vars": {
          "type": "object",
          "additionalProperties": true
        },
        "testdata": {
          "$ref": "#/$defs/workloadTestdata"
        },
        "load": {
          "$ref": "#/$defs/loadOverride"
        },
        "execution": {
          "$ref": "#/$defs/workloadExecution"
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "evidence": {
          "$ref": "#/$defs/workloadEvidence"
        },
        "mix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mixEntry"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "target"
          ],
          "not": {
            "required": [
              "mix"
            ]
          }
        },
        {
          "required": [
            "mix"
          ],
          "not": {
            "required": [
              "target"
            ]
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "template",
            "flow",
            "tool"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "workloadTestdata": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          {
            "pattern": "^x-"
          }
        ]
      },
      "patternProperties": {
        "^(?!x-)[A-Za-z][A-Za-z0-9_-]*$": {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "workload",
                "user",
                "iteration"
              ]
            },
            "selection": {
              "$ref": "#/$defs/selection"
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "^x-": {}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "sequential",
            "roundRobin",
            "random"
          ]
        },
        "exhaustion": {
          "enum": [
            "error",
            "recycle",
            "stop"
          ]
        },
        "seed": {
          "type": "integer"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "load": {
      "type": "object",
      "required": [
        "duration"
      ],
      "properties": {
        "users": {
          "type": "integer",
          "minimum": 1
        },
        "arrivalRate": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?/(s|m)$"
        },
        "warmup": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "rampUp": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "duration": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "rampDown": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1
        },
        "overloadPolicy": {
          "const": "drop"
        }
      },
      "oneOf": [
        {
          "required": [
            "users"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "arrivalRate"
                ]
              },
              {
                "required": [
                  "maxConcurrent"
                ]
              },
              {
                "required": [
                  "overloadPolicy"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "arrivalRate",
            "maxConcurrent",
            "overloadPolicy"
          ],
          "not": {
            "required": [
              "users"
            ]
          }
        }
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "loadOverride": {
      "type": "object",
      "properties": {
        "users": {
          "type": "integer",
          "minimum": 1
        },
        "arrivalRate": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?/(s|m)$"
        },
        "warmup": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "rampUp": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "duration": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "rampDown": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1
        },
        "overloadPolicy": {
          "const": "drop"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "workloadExecution": {
      "type": "object",
      "properties": {
        "thinkTime": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)$"
                },
                "max": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)$"
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "rootExecution": {
      "type": "object",
      "properties": {
        "thinkTime": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)$"
                },
                "max": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)$"
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "errorRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "p95": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?ms$"
        },
        "p99": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?ms$"
        },
        "minThroughput": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "droppedRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "achievedArrivalRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?(%|/(s|m))$"
        },
        "runtimeErrorRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "totalErrorRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "startedRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "completedRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "successfulRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "steady": {
          "$ref": "#/$defs/legacyThresholds"
        },
        "overall": {
          "$ref": "#/$defs/legacyThresholds"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "success": {
          "enum": [
            "none",
            "sample",
            "full"
          ]
        },
        "failure": {
          "enum": [
            "none",
            "full"
          ]
        },
        "mode": {
          "enum": [
            "metrics",
            "failures",
            "samples",
            "all"
          ]
        },
        "sampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quotaScope": {
          "enum": [
            "perWorkload"
          ]
        },
        "defaults": {
          "$ref": "#/$defs/perWorkloadCaps"
        },
        "maxSamples": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "properties": {
            "output": {
              "enum": [
                "inherit",
                "none"
              ],
              "default": "inherit"
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "maxSuccessSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxFailureSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "dependentRequired": {
        "maxSuccessSamples": [
          "maxFailureSamples"
        ]
      },
      "not": {
        "required": [
          "maxSamples",
          "maxSuccessSamples"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "quotaScope"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "maxSamples"
                  ]
                },
                {
                  "required": [
                    "maxSuccessSamples"
                  ]
                },
                {
                  "required": [
                    "maxFailureSamples"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "defaults"
            ]
          },
          "then": {
            "required": [
              "quotaScope"
            ]
          }
        },
        {
          "if": {
            "required": [
              "maxFailureSamples"
            ]
          },
          "then": {
            "properties": {
              "maxSamples": {
                "maximum": 1000000
              }
            }
          }
        }
      ]
    },
    "perWorkloadCaps": {
      "type": "object",
      "properties": {
        "maxSuccessSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxFailureSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "workloadEvidence": {
      "$ref": "#/$defs/perWorkloadCaps"
    },
    "mixEntry": {
      "type": "object",
      "required": [
        "id",
        "weight",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": true
        },
        "vars": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "legacyThresholds": {
      "type": "object",
      "properties": {
        "errorRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "p95": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?ms$"
        },
        "p99": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?ms$"
        },
        "minThroughput": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "droppedRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "achievedArrivalRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?(%|/(s|m))$"
        },
        "runtimeErrorRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "totalErrorRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?%$"
        },
        "startedRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "completedRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        },
        "successfulRate": {
          "type": "string",
          "pattern": "^(<|<=|>|>=|==)\\s*[0-9]+(\\.[0-9]+)?/(s|m)$"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": [
        "schemaVersion",
        "collections"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "att-load-observability/v1"
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/observabilityBinding"
          }
        },
        "collection": {
          "$ref": "#/$defs/observabilityCollection"
        },
        "livePreview": {
          "$ref": "#/$defs/observabilityLivePreview"
        }
      }
    },
    "observabilityBinding": {
      "type": "object",
      "required": [
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "targetIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "parameters": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "observabilityCollection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "post-run"
        },
        "step": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$"
        },
        "before": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$"
        },
        "after": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h|d|w|y)$"
        }
      }
    },
    "observabilityLivePreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "const": "30s"
        },
        "defaultRange": {
          "const": "15m"
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
