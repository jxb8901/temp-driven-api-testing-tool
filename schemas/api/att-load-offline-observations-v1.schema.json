{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:api-schema:load-offline-observations:v1",
  "$comment": "Server-owned offline report contract; not registered in the Engine schema catalog.",
  "title": "ATT offline SUT observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "snapshotId",
    "state",
    "complete",
    "window",
    "sampleResolution",
    "coverage",
    "queries",
    "observations",
    "diagnostics",
    "sourceManifestSha256",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-load-offline-observations/v1"
    },
    "jobId": {
      "type": "string",
      "pattern": "^J[A-F0-9]{16}$"
    },
    "snapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "DISABLED",
        "PENDING",
        "COLLECTING",
        "READY",
        "PARTIAL",
        "UNAVAILABLE",
        "FAILED"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "sampleResolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "type": "object"
    },
    "queries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/group" }
    },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "sourceManifestSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholdVerdict",
        "correlation",
        "futureObservationTypes"
      ],
      "properties": {
        "thresholdVerdict": {
          "type": "object",
          "required": [
            "schemaVersion",
            "state",
            "reference"
          ],
          "properties": {
            "schemaVersion": {
              "const": "att-load-verdict/v1"
            },
            "state": {
              "type": "string"
            },
            "reference": {
              "const": "load-verdict/v1/manifest.json"
            }
          }
        },
        "correlation": {
          "type": "object",
          "required": [
            "schemaVersion",
            "state"
          ],
          "properties": {
            "schemaVersion": {
              "const": "att-load-correlation/v1"
            },
            "state": {
              "const": "NOT_INCLUDED"
            }
          }
        },
        "futureObservationTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 512 }
    },
    "group": {
      "type": "object",
      "required": ["schemaVersion", "id", "title", "order", "match", "groupBy", "display"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "att-sut-metrics-group/v1" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "match": {
          "type": "object", "maxProperties": 3, "additionalProperties": false,
          "properties": {
            "metricIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 80 } },
            "sourceIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 80 } },
            "labels": { "$ref": "#/$defs/labels" }
          },
          "anyOf": [{ "required": ["metricIds"] }, { "required": ["sourceIds"] }, { "required": ["labels"] }]
        },
        "groupBy": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
        "display": { "enum": ["auto", "summary", "table", "chart"] }
      }
    },
    "groupView": {
      "type": "object",
      "required": ["schemaVersion", "assignments", "unassigned", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "att-sut-metrics-group-view/v1" },
        "assignments": {
          "type": "array", "maxItems": 4096,
          "items": { "type": "object", "required": ["observationId", "groupId", "labels", "groupBy"],
            "properties": {
              "observationId": { "type": "string", "maxLength": 64 }, "groupId": { "type": "string", "maxLength": 80 },
              "title": { "type": "string", "maxLength": 120 }, "order": { "type": "integer" },
              "display": { "type": "string", "maxLength": 16 }, "labels": { "$ref": "#/$defs/labels" },
              "groupBy": { "$ref": "#/$defs/labels" },
              "value": { "type": ["number", "null"] },
              "status": { "enum": ["AVAILABLE", "PARTIAL", "NO_DATA", "UNAVAILABLE", "NOT_EVALUATED"] },
              "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
              "observedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "unassigned": {
          "type": "array", "maxItems": 4096,
          "items": { "type": "object", "required": ["observationId", "labels"],
            "properties": {
              "observationId": { "type": "string", "maxLength": 64 }, "metricId": { "type": "string", "maxLength": 80 },
              "sourceId": { "type": "string", "maxLength": 120 }, "reason": { "type": "string", "maxLength": 40 },
              "labels": { "$ref": "#/$defs/labels" }
            }
          }
        },
        "diagnostics": {
          "type": "array", "maxItems": 4096,
          "items": { "type": "object", "required": ["code", "observationId", "message"],
            "properties": {
              "code": { "type": "string", "maxLength": 64 }, "observationId": { "type": "string", "maxLength": 64 },
              "groupId": { "type": "string", "maxLength": 80 }, "groupIds": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 80 } },
              "label": { "type": "string", "maxLength": 64 }, "message": { "type": "string", "maxLength": 256 }
            }
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startAt",
        "endAt",
        "phaseWindows"
      ],
      "properties": {
        "startAt": {
          "$ref": "#/$defs/time"
        },
        "endAt": {
          "$ref": "#/$defs/time"
        },
        "observedAt": {
          "$ref": "#/$defs/time"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "phaseWindows": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "id",
        "profile",
        "profilePath",
        "sourceId",
        "targetId",
        "metricId",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "profile": {
          "type": "string",
          "maxLength": 128
        },
        "profilePath": {
          "type": "string",
          "maxLength": 256
        },
        "sourceId": {
          "type": "string",
          "maxLength": 128
        },
        "sourceName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "targetId": {
          "type": "string",
          "maxLength": 128
        },
        "targetType": {
          "type": "string",
          "maxLength": 128
        },
        "metricId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 128
        },
        "unit": {
          "type": "string",
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "maxLength": 64
        },
        "sourceRevision": {
          "$ref": "#/$defs/digest"
        },
        "profileRevision": {
          "$ref": "#/$defs/digest"
        },
        "targetRevision": {
          "$ref": "#/$defs/digest"
        },
        "scope": {
          "enum": [
            "job",
            "workload",
            "mix"
          ]
        },
        "workloadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mixId": {
          "type": [
            "string",
            "null"
          ]
        },
        "callGroupId": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "source",
        "metric",
        "profile",
        "target",
        "window",
        "sampleResolution",
        "coverage",
        "quality",
        "path",
        "sourceSha256",
        "sha256",
        "lengthBytes",
        "seriesCount",
        "sampleCount",
        "previewOmittedSeriesCount",
        "preview"
      ],
      "properties": {
        "schemaVersion": {
          "const": "att-load-offline-observation/v1"
        },
        "kind": {
          "enum": [
            "timeseries",
            "business-value"
          ]
        },
        "source": {
          "type": "object"
        },
        "metric": {
          "type": "object"
        },
        "profile": {
          "type": "object"
        },
        "target": {
          "type": "object"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "sampleResolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": "object"
        },
        "quality": {
          "type": "object"
        },
        "path": {
          "type": "string",
          "pattern": "^report/v2/sut-metrics/observations/observation-[0-9]{4}\\.json$"
        },
        "sourceSha256": {
          "$ref": "#/$defs/digest"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "lengthBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "seriesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "previewOmittedSeriesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "preview": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "labels",
              "samples"
            ],
            "properties": {
              "labels": {
                "type": "object"
              },
              "samples": {
                "type": "array",
                "maxItems": 96,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "timestamp",
                    "timestampEpochMs",
                    "value",
                    "gapBefore"
                  ],
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "timestampEpochMs": {
                      "type": "integer"
                    },
                    "value": {
                      "type": "number"
                    },
                    "gapBefore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "groupView": { "$ref": "#/$defs/groupView" },
        "labeledValues": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": ["labels", "value"],
            "additionalProperties": false,
            "properties": {
              "labels": { "$ref": "#/$defs/labels" },
              "value": { "type": ["number", "null"] },
              "state": { "enum": ["AVAILABLE", "PARTIAL", "NO_DATA", "UNAVAILABLE", "NOT_EVALUATED"] },
              "diagnostics": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["code", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$" },
                    "message": { "type": "string", "maxLength": 240 }
                  }
                }
              }
            }
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "job",
            "workload",
            "mix"
          ]
        },
        "workloadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mixId": {
          "type": [
            "string",
            "null"
          ]
        },
        "callGroupId": {
          "type": "string",
          "maxLength": 512
        },
        "callCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "mappingStatus": {
          "type": "string",
          "maxLength": 32
        },
        "unmatchedRowCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "timeseries"
            }
          },
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "business-value"
            }
          },
          "required": [
            "value"
          ]
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "queryId": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
