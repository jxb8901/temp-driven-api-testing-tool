{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:att:api-schema:job-execution:v2",
  "title": "ATT safely retained Job execution specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revisionPolicy", "revision", "definition"],
  "properties": {
    "schemaVersion": { "const": "att-job-execution/v2" },
    "revisionPolicy": { "const": "reject-package-changes" },
    "revision": { "$ref": "#/definitions/digest" },
    "sourcePath": { "type": "string", "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\\\x00-\\x1f\\x7f]).*$" },
    "configuration": { "type": "object" },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceJobId", "sourcePolicy", "originalRevision", "effectiveRevision"],
      "properties": {
        "sourceJobId": { "type": "string", "pattern": "^J[A-F0-9]{16}$" },
        "sourcePolicy": { "enum": ["current", "strict"] },
        "originalRevision": { "$ref": "#/definitions/digest" },
        "effectiveRevision": { "$ref": "#/definitions/digest" }
      }
    },
    "definition": {
      "type": "object",
      "required": ["executionType", "packageId"],
      "properties": {
        "executionType": { "enum": ["run", "load"] },
        "packageId": { "type": "string", "minLength": 1 },
        "environment": { "type": ["string", "null"] },
        "scenario": { "type": "object" }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
