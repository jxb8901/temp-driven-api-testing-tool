{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:tool-group:v2.9",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-tool-group/v2.9"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "$ref": "#/$defs/command"
    },
    "ssh": {
      "oneOf": [
        {
          "$ref": "#/$defs/ssh"
        },
        {
          "type": "object",
          "required": [
            "helper"
          ],
          "properties": {
            "helper": {
              "type": "string",
              "minLength": 1
            },
            "selection": {
              "type": "object",
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "random",
                    "roundRobin",
                    "all"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "ssh": {
      "type": "object",
      "required": [
        "host",
        "user"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "identityFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "description",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "argName": {
          "type": "string",
          "pattern": "^\\S*$"
        },
        "argNameMode": {
          "enum": [
            "once",
            "repeat"
          ],
          "default": "once"
        },
        "delimit": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "call": {
          "type": "string",
          "minLength": 1,
          "pattern": "^#\\{[\\s\\S]*\\}$"
        },
        "cache": {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "enum": [
                "case",
                "db"
              ]
            }
          },
          "additionalProperties": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "arguments": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argument"
          }
        },
        "stdoutFormat": {
          "enum": [
            "text",
            "json",
            "yaml",
            "xml"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "command",
            "stdoutFormat"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "call"
                ]
              },
              {
                "required": [
                  "cache"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "call"
          ],
          "not": {
            "required": [
              "command"
            ]
          }
        }
      ],
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "command"
            ]
          },
          "then": {
            "required": [
              "stdoutFormat"
            ]
          },
          "else": {
            "not": {
              "required": [
                "stdoutFormat"
              ]
            }
          }
        }
      ]
    }
  }
}
