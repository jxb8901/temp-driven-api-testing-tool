{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:httphelper:v1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "baseUrl"],
  "properties": {
    "schemaVersion": {"const": "att-httphelper/v1.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "baseUrl": {"type": "string", "minLength": 1},
    "defaults": {"type": "object", "properties": {
      "headers": {"$ref": "#/$defs/headers"},
      "connectTimeoutMs": {"$ref": "#/$defs/timeout"},
      "readTimeoutMs": {"$ref": "#/$defs/timeout"},
      "followRedirects": {"type": "boolean"}
    }, "additionalProperties": false},
    "pool": {"type": "object", "properties": {
      "maxConnections": {"type": "integer", "minimum": 1, "maximum": 10000},
      "maxConnectionsPerRoute": {"type": "integer", "minimum": 1, "maximum": 10000},
      "connectionRequestTimeoutMs": {"$ref": "#/$defs/timeout"},
      "keepAliveMs": {"$ref": "#/$defs/timeout"},
      "idleEvictMs": {"$ref": "#/$defs/timeout"}
    }, "additionalProperties": false},
    "auth": {"type": "object", "properties": {
      "type": {"enum": ["none", "basic", "bearer"]},
      "username": {"type": "string"},
      "password": {"type": "string"},
      "token": {"type": "string"}
    }, "additionalProperties": false},
    "tls": {"type": "object", "properties": {
      "verifyHostname": {"const": true},
      "trustStore": {"type": "string", "minLength": 1},
      "trustStorePassword": {"type": "string"}
    }, "additionalProperties": false}
  },
  "$defs": {
    "timeout": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "headers": {"type": "object", "propertyNames": {"pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"}, "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
