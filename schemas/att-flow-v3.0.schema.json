{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:flow:v3.0",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "inputs", "actions", "outputs"],
  "properties": {
    "schemaVersion": {"const": "att-flow/v3.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "inputs": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/input"}},
    "actions": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[^.]+$"}, "additionalProperties": {"$ref": "#/$defs/action"}},
    "outputs": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/output"}}
  },
  "additionalProperties": false,
  "$defs": {
    "valueType": {"enum": ["string", "integer", "number", "boolean", "object", "array"]},
    "input": {
      "type": "object", "required": ["type"],
      "properties": {"type": {"$ref": "#/$defs/valueType"}, "required": {"type": "boolean", "default": false}, "default": {}},
      "not": {"required": ["default", "required"], "properties": {"required": {"const": true}}},
      "allOf": [
        {"if": {"required": ["default"], "properties": {"type": {"const": "string"}}}, "then": {"properties": {"default": {"type": "string"}}}},
        {"if": {"required": ["default"], "properties": {"type": {"const": "integer"}}}, "then": {"properties": {"default": {"type": "integer"}}}},
        {"if": {"required": ["default"], "properties": {"type": {"const": "number"}}}, "then": {"properties": {"default": {"type": "number"}}}},
        {"if": {"required": ["default"], "properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"default": {"type": "boolean"}}}},
        {"if": {"required": ["default"], "properties": {"type": {"const": "object"}}}, "then": {"properties": {"default": {"type": "object"}}}},
        {"if": {"required": ["default"], "properties": {"type": {"const": "array"}}}, "then": {"properties": {"default": {"type": "array"}}}}
      ],
      "additionalProperties": false
    },
    "output": {"type": "object", "required": ["type", "from"], "properties": {"type": {"$ref": "#/$defs/valueType"}, "from": {"type": "string", "pattern": "^\\$\\{.+\\}$"}}, "additionalProperties": false},
    "action": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": {"enum": ["render", "tool", "db", "assert", "log", "assign", "flow"]}, "description": {"type": "string"}, "onFailure": {"enum": ["stop", "continue"]}, "runWhen": {"type": "string", "minLength": 1},
        "name": {"type": "string"}, "expression": {"type": "string"}, "payload": {"type": "string"}, "renderAs": {"enum": ["file", "text", "json", "yaml", "xml"]}, "saveAs": {}, "call": {"type": "string"},
        "db": {"type": "string"}, "query": {"type": "object"}, "update": {"type": "object"}, "assert": {"type": "string"}, "expected": {"type": "string"}, "actual": {"type": "string"},
        "message": {"type": "string"}, "file": {"type": "string"}, "level": {"enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"]}, "fields": {"type": "object"}, "timeoutMs": {"type": "integer"}, "retry": {"type": "object"},
        "use": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"}, "with": {"type": "object"}
      },
      "patternProperties": {"^x-": {}}, "additionalProperties": false,
      "allOf": [{"if": {"properties": {"type": {"const": "flow"}}}, "then": {"required": ["use"]}}]
    }
  }
}
