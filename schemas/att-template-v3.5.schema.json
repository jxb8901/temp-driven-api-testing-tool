{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:template:v3.5",
  "type": "object",
  "required": [
    "schemaVersion",
    "description",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "att-template/v3.5"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[^.]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "sqlBlock": {
      "type": "object",
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "sqlFile": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "oneOf": [
            {
              "type": "array"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "sql"
          ],
          "not": {
            "required": [
              "sqlFile"
            ]
          }
        },
        {
          "required": [
            "sqlFile"
          ],
          "not": {
            "required": [
              "sql"
            ]
          }
        }
      ],
      "allOf": [
        {
          "not": {
            "required": [
              "params",
              "parameters"
            ]
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "required": [
        "maxAttempts",
        "intervalMs",
        "retryOn"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "retryOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ASSERTION",
              "TIMEOUT"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "common": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "tool",
            "db",
            "assert",
            "log",
            "assign",
            "flow"
          ]
        },
        "description": {
          "type": "string"
        },
        "onFailure": {
          "enum": [
            "stop",
            "continue"
          ]
        },
        "runWhen": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "type": "string",
          "minLength": 1
        },
        "db": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "query": {
          "$ref": "#/$defs/sqlBlock"
        },
        "update": {
          "$ref": "#/$defs/sqlBlock"
        },
        "assert": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[^.]+$"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "use": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"
        },
        "value": {},
        "format": {
          "enum": [
            "text",
            "json",
            "yaml",
            "xml",
            "sqlplus"
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "action": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
