{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:load-detail-series:v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "part", "parts", "total", "contentSha256", "items"],
  "properties": {
    "schemaVersion": { "const": "att-load-detail-series/v2" },
    "kind": { "enum": ["map", "list"] },
    "part": { "type": "integer", "minimum": 1 },
    "parts": { "type": "integer", "minimum": 1 },
    "total": { "type": "integer", "minimum": 1 },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "items": {}
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "map" } } }, "then": { "properties": { "items": { "type": "object" } } } },
    { "if": { "properties": { "kind": { "const": "list" } } }, "then": { "properties": { "items": { "type": "array" } } } }
  ],
  "additionalProperties": false
}
