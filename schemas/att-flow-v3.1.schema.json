{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:flow:v3.1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "actions"],
  "properties": {
    "schemaVersion": {"const": "att-flow/v3.1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "actions": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[^.]+$"}, "additionalProperties": {"$ref": "#/$defs/action"}}
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": {"enum": ["render", "tool", "db", "assert", "log", "assign", "flow"]}, "description": {"type": "string"}, "onFailure": {"enum": ["stop", "continue"]}, "runWhen": {"type": "string", "minLength": 1},
        "name": {"type": "string"}, "expression": {"type": "string"}, "payload": {"type": "string"}, "result": {"type": "object", "properties": {"format": {"enum": ["raw", "text", "json", "yaml", "xml"]}, "path": {"type": "string", "minLength": 1}, "overwrite": {"type": "boolean"}}, "additionalProperties": false}, "call": {"type": "string"},
        "db": {"type": "string"}, "query": {"type": "object"}, "update": {"type": "object"}, "assert": {"type": "string"}, "expected": {"type": "string"}, "actual": {"type": "string"},
        "message": {"type": "string"}, "file": {"type": "string"}, "level": {"enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"]}, "fields": {"type": "object"}, "timeoutMs": {"type": "integer"}, "retry": {"type": "object"},
        "evidence": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[^.]+$"}, "additionalProperties": {"$ref": "#/$defs/evidenceCollector"}},
        "use": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.v[1-9][0-9]*$"}
      },
      "patternProperties": {"^x-": {}}, "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "flow"}}}, "then": {"required": ["use"]}},
        {"if": {"not": {"properties": {"type": {"const": "tool"}}}}, "then": {"not": {"required": ["evidence"]}}}
      ]
    },
    "evidenceCollector": {
      "type": "object",
      "required": ["call"],
      "properties": {
        "call": {"type": "string", "minLength": 1},
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "onFailure": {"enum": ["stop", "continue"]}
      },
      "additionalProperties": false
    }
  }
}
