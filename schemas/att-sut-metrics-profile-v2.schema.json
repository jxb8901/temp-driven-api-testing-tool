{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:sut-metrics-profile:v2",
  "title": "ATT flat SUT Metrics Profile",
  "description": "A flat selection of Metric Sources and Groups with a bounded allowlist of execution bindings. Profile inheritance is not supported.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "metricSourceIds", "groupIds", "allowedBindings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "att-sut-metrics-profile/v2" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 512 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metricSourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" }
    },
    "groupIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" }
    },
    "allowedBindings": {
      "type": "object",
      "required": ["environments", "targets", "tenants", "parameters"],
      "additionalProperties": false,
      "properties": {
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "targets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["template", "tool", "workload", "target"] },
              "id": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        },
        "tenants": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "parameters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["text", "enum", "number", "duration", "promLabelValue"] },
              "required": { "type": "boolean" },
              "allowedValues": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "type": ["string", "number"] }
              }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFetches": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxObservations": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxArtifactBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 }
      }
    }
  }
}
