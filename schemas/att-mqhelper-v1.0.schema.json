{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:att:schema:mqhelper:v1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "connection"],
  "properties": {
    "schemaVersion": {"const": "att-mqhelper/v1.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "connection": {"$ref": "#/$defs/connection"},
    "message": {"$ref": "#/$defs/message"},
    "requestReply": {"$ref": "#/$defs/requestReply"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "pool": {"$ref": "#/$defs/pool"}
  },
  "patternProperties": {"^x-": {}},
  "additionalProperties": false,
  "$defs": {
    "connection": {
      "type": "object",
      "required": ["queueManager", "host", "port", "channel"],
      "properties": {
        "queueManager": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "channel": {"type": "string", "minLength": 1},
        "username": {"type": "string"},
        "password": {"type": "string"}
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "ccsid": {"type": "integer", "minimum": 1, "maximum": 65535},
        "format": {"enum": ["MQSTR", "MQHRF2", "MQFMT_STRING", "MQFMT_NONE", "NONE"]},
        "persistence": {"enum": ["asQueue", "persistent", "notPersistent", "nonPersistent"]}
      },
      "additionalProperties": false
    },
    "requestReply": {
      "type": "object",
      "properties": {
        "waitMs": {"type": "integer", "minimum": 0, "maximum": 3600000}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "payload": {"enum": ["none", "metadata"]}
      },
      "additionalProperties": false
    },
    "pool": {
      "type": "object",
      "properties": {
        "maxSize": {"type": "integer", "minimum": 1, "maximum": 10000},
        "minIdle": {"type": "integer", "minimum": 0, "maximum": 10000},
        "borrowTimeout": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"}]}
      },
      "additionalProperties": false
    }
  }
}
